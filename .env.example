DATABASE_URL="file:./dev.db"

# Password Dani uses to log into /admin
ADMIN_PASSWORD="changeme"

# Long random string used to sign the admin session cookie
SESSION_SECRET="replace-with-a-long-random-string"

# --- Server deployment (docker compose + Traefik) ---
# Subdomain pointing at the server
APP_DOMAIN="padel.example.com"
# Must match your existing Traefik setup
TRAEFIK_NETWORK="traefik"
TRAEFIK_ENTRYPOINT="websecure"
TRAEFIK_CERTRESOLVER="letsencrypt"

# "true" shows a "coming soon" page to visitors (logged-in admin still sees the site)
MAINTENANCE_MODE="false"

# --- Email alert to Dani on every new booking ---
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) as SMTP_PASS.
# Leave SMTP_PASS empty to disable.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="daniel.pavel.neamtiu@gmail.com"
SMTP_PASS=""
NOTIFY_EMAIL="daniel.pavel.neamtiu@gmail.com"
