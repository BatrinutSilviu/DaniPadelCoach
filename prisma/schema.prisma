generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A bookable course. `slug` links it to the course cards on the site.
// `capacity` is how many bookings can share the same session (1 = private).
model Service {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  // Usual session length; single slots can be changed (SlotLength).
  durationMin Int                @default(60)
  capacity    Int                @default(1)
  // Every session of this course is for children.
  forKids     Boolean            @default(false)
  order       Int                @default(0)
  isActive    Boolean            @default(true)
  bookings    Booking[]
  rules       AvailabilityRule[]
  priceTiers  PriceTier[]
  venues      ServiceVenue[]
}

// Whether Dani trains this course at a venue (e.g. no kids at X3 Padel).
// When not, the venue's prices are hidden and its slots aren't bookable
// for the course. Rows are seeded for every course and venue.
model ServiceVenue {
  id        String  @id @default(cuid())
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  // Venue name from venueNames in src/lib/site.ts.
  location  String
  isOffered Boolean @default(true)

  @@unique([serviceId, location])
}

// One row of a course's price table at one venue, e.g. "Duo (2 persoane)"
// at "X3 Padel". Rows are seeded; the admin only edits the amounts.
model PriceTier {
  id        String  @id @default(cuid())
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  label     String
  // Venue name from venueNames in src/lib/site.ts; "" only on rows from
  // before prices were per venue, which the seed migrates and removes.
  location  String  @default("")
  order     Int     @default(0)
  // Amount in lei, per the unit in the label; null = not set yet.
  price     Int?

  @@unique([serviceId, label, location])
}

// A single slot (date + start time) the admin made longer than the
// course's usual length; the following slots that day start after it.
model SlotLength {
  id          String @id @default(cuid())
  date        String // "YYYY-MM-DD"
  startTime   String // "HH:mm"
  durationMin Int

  @@unique([date, startTime])
}

// Recurring weekly window, e.g. "every Monday 17:00-18:30".
// serviceId = null means the window is open for every course.
// location = null means the client picks the venue.
// kidsOnly = only bookings for children fit in this window.
model AvailabilityRule {
  id        String   @id @default(cuid())
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  location  String?
  kidsOnly  Boolean  @default(false)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String?
}

// One-off override for a calendar date: fully closed, or a custom
// open window (for every course) that replaces that day's weekly rules.
model AvailabilityException {
  id        String  @id @default(cuid())
  date      String  @unique // "YYYY-MM-DD"
  isClosed  Boolean @default(true)
  startTime String?
  endTime   String?
  location  String?
  kidsOnly  Boolean @default(false)
}

// status is "PENDING" | "CONFIRMED" | "CANCELLED" (SQLite has no enums).
// Pending and confirmed bookings both hold their slot.
model Booking {
  id          String   @id @default(cuid())
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   String
  date        String // "YYYY-MM-DD"
  startTime   String // "HH:mm"
  endTime     String // "HH:mm"
  location    String
  clientName  String
  clientPhone String
  clientEmail String?
  notes       String?
  level       String?
  // People coming. In a group course each one takes a place; a private
  // lesson is exclusive whatever the number.
  participants Int     @default(1)
  // false = nobody else may join this group session.
  openToOthers Boolean @default(true)
  // How many people from other bookings may share the session with this
  // one: null = any, 0 = none (then openToOthers is false too).
  maxStrangers Int?
  // Booked by a parent for children; one BookingChild per participant.
  forKids     Boolean  @default(false)
  children    BookingChild[]
  status      String   @default("PENDING")
  // Added by the admin to occupy a slot (e.g. a phone booking).
  byAdmin     Boolean  @default(false)
  // When the 10:00 reminder email went out on the day of the session.
  reminderSentAt DateTime?
  createdAt   DateTime @default(now())

  @@index([date])
}

model BookingChild {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  name      String
  age       Int
}

// Shown in the Events section of the site while `date` is today or later.
model Event {
  id          String   @id @default(cuid())
  title       String
  date        String // "YYYY-MM-DD"
  startTime   String? // "HH:mm"
  location    String
  description String
  createdAt   DateTime @default(now())

  @@index([date])
}

// Shown in the sponsors strip before the footer, in `order`. The logo is
// stored in the database so it lives with the rest of the data.
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  url       String?
  logo      Bytes
  logoType  String // MIME type, e.g. "image/png"
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}
